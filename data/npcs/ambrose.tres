[resource]
script = ExtResource("1_data")
id = &"ambrose"
display_name = "Mr. Ambrose"
role = "Librarian"
model = ExtResource("3_model")
animations = ExtResource("4_anims")
model_scale = 1.86
walk_speed = 1
intro_lines = PackedStringArray("Ah. A new face. And a curious one, I'd wager.", "Ambrose, librarian. The books outnumber the readers on this island, I'm afraid.", "Your grandfather wrote in a dreadful shorthand. If you ever find his notes, bring them to me.")
later_lines = PackedStringArray("Every old building here has a story. Most of them are in my library, gathering dust.", "The island's founders called the spring under the lake the Moonwell. A pretty name for an odd thing.", "Do mind the books on your way out. They are older than both of us combined.", "Reading costs no coins and very little time. A splendid bargain.")
schedule = Array[ExtResource("2_entry")]([SubResource("Entry_0"), SubResource("Entry_1"), SubResource("Entry_2")])
story_lines = {
&"ch3_market_day": PackedStringArray("Market Day. I'd quite forgotten the sound of it.", "Your grandfather's ledger was right about everything, you know. The island remembered how to gather.")
}
friend_lines = PackedStringArray("Your grandfather borrowed eleven books and returned twelve. I never found out where the twelfth came from.", "There's a shelf in the library I keep just for your discoveries.")
loved_items = Array[StringName]([&"azure_manta", &"moonfin_koi", &"turnip_soup"])
liked_items = Array[StringName]([&"bread", &"sunflower", &"garden_pie"])
liked_categories = Array[int]([])
disliked_items = Array[StringName]([&"fertilizer"])
loved_line = "Remarkable! A specimen worthy of the island's records. Thank you."
liked_line = "How kind. I'll enjoy this with my tea."
neutral_line = "Thank you. Most considerate."
disliked_line = "Ah. Fertilizer. I shall… file it appropriately."
