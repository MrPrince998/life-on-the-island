or_event = &""

[resource]
script = ExtResource("1_quest")
id = &"mend_greenhouse"
title = "Mend the Greenhouse"
giver = "Mia"
description = "Grandpa's greenhouse by the fields is falling apart. Planks and a few coins would fix it."
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3")])
