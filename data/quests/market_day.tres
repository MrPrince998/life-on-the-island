[resource]
script = ExtResource("1_quest")
id = &"market_day"
title = "Ch. 3: Market Day"
giver = "Emma"
description = "Mend the four market stalls by the well and stock them with fish and crops, and Willowbrook can hold a market again."
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4")])
starts_active = false
start_flag = &""
next_quest = &"well_light"
reward_coins = 120
reward_items = {}
reward_flags = Array[StringName]([&"ch3_market_day", &"restored_inn", &"restored_house_1", &"restored_house_2"])
reward_friendship = 0
giver_id = &""
offer_hearts = 1
requires_quest = &""
requires_flag = &""
offer_lines = PackedStringArray()
complete_message = "Market Day! The lamps are lit along every path, the stalls are full, Nana Bea has reopened her inn and two families have moved back into their houses. Willowbrook is waking up."
