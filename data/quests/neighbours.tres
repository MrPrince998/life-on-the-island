[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
text = "Meet Oliver by the lake north of the village"
kind = 0
target = &"met_oliver"
amount = 1
or_event = &""

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_step")
text = "Meet Mia at the garden beds east of the village"
kind = 0
target = &"met_mia"
amount = 1
or_event = &""

[resource]
script = ExtResource("1_quest")
id = &"neighbours"
title = "Friendly Faces"
giver = "Grandpa's letter"
description = "Take the north path from the village to Moonlit Lake. Oliver fishes at the dock in the morning and evening, and sits on the nearby bench at midday. Mia works around the garden beds in Sunflower Fields, east of the village."
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2")])
starts_active = true
start_flag = &""
next_quest = &"little_kindness"
reward_coins = 0
complete_message = ""
