[resource]
script = ExtResource("1_quest")
id = &"carpenters_bridge"
title = "Ch. 2: The Carpenter's Bridge"
giver = "Theo"
description = "Theo can't rebuild Grandpa's bridge over Willow Creek alone. Beyond it, Fernwood Forest and its ancient oak are sleeping."
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5")])
starts_active = false
start_flag = &"met_theo"
next_quest = &""
reward_coins = 100
complete_message = "The bridge stands again, the ancient oak is in full leaf and the second Glowstone glows in your bag. Birdsong fills Fernwood Forest. Chapter 2 complete!"
