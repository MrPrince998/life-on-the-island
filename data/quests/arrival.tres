[ext_resource type="Script" path="res://scripts/resources/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
text = "Meet Emma at the red-roofed shop east of the village well"
kind = 0
target = &"met_emma"
amount = 1
or_event = &"open_shop"

[resource]
script = ExtResource("1_quest")
id = &"arrival"
title = "Welcome to Willowbrook"
giver = "Grandpa's letter"
description = "Follow the path inland from the beach to Willowbrook Village. Emma runs the red-roofed General Store east of the well. She waits by the shop, or visits the well in the evening. Speak to her or use the shop counter."
steps = Array[ExtResource("2_step")]([SubResource("Step_1")])
starts_active = false
start_flag = &"opening_seen"
next_quest = &""
reward_coins = 0
complete_message = "Emma hands you Grandpa's key. Welcome home."
