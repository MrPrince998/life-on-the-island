[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
text = "Catch a fish from the dock at Moonlit Lake"
kind = 3
target = &"catch_fish"
amount = 1
or_event = &""

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_step")
text = "Sell a fish at the shop counter east of the village well"
kind = 3
target = &"sell_fish"
amount = 1
or_event = &""

[resource]
script = ExtResource("1_quest")
id = &"fishing_lessons"
title = "Oliver's Lessons"
giver = "Oliver"
description = "Fish from the dock at Moonlit Lake, north of the village. Equip the rod, hold and release to cast, then hook when the bobber dips. Reel gently and ease off when the line turns red. Sell your catch at the General Store counter east of the village well."
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2")])
starts_active = false
start_flag = &"has_fishing_rod"
next_quest = &""
reward_coins = 20
complete_message = "Oliver would be proud."
