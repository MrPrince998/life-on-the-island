[resource]
script = ExtResource("1_quest")
id = &"grandpas_garden"
title = "Grandpa's Garden"
giver = "Grandpa's letter"
description = "The garden beds on the Sunflower Fields have run wild. Grow something again."
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5")])
starts_active = true
start_flag = &""
next_quest = &"mend_greenhouse"
reward_coins = 30
complete_message = "The garden is growing again."
