[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
text = "Go east to the farm; collect the can and seeds by the garden shed"
kind = 1
target = &"watering_can"
amount = 1
or_event = &""

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_step")
text = "Dig one of the small garden beds beside the shed"
kind = 3
target = &"dig"
amount = 1
or_event = &""

[sub_resource type="Resource" id="Step_3"]
script = ExtResource("2_step")
text = "Plant the free turnip seeds in your dug garden bed"
kind = 3
target = &"plant"
amount = 1
or_event = &""

[sub_resource type="Resource" id="Step_4"]
script = ExtResource("2_step")
text = "Water the crop, sleep at your cottage, then return to harvest"
kind = 3
target = &"harvest"
amount = 1
or_event = &""

[sub_resource type="Resource" id="Step_5"]
script = ExtResource("2_step")
text = "Sell a crop at the shop counter east of the village well"
kind = 3
target = &"sell_crop"
amount = 1
or_event = &""

[resource]
script = ExtResource("1_quest")
id = &"grandpas_garden"
title = "Grandpa's Garden"
giver = "Grandpa's letter"
description = "Follow the east path from Willowbrook to Sunflower Fields. The garden shed is northwest of the small garden beds, with a watering can and free seeds outside. Interact with a bed to dig, plant and water. Time advances when you work or rest, not while you wait; sleep at your cottage and return to check the crop."
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5")])
starts_active = true
start_flag = &""
next_quest = &"mend_greenhouse"
reward_coins = 30
complete_message = "The garden is growing again."
