requires_quest = &""
requires_flag = &""
offer_lines = PackedStringArray("Sunflowers turn to follow the sun all day. I turn to follow the stars all night.", "Would you bring me three? They'd keep me company up in the lighthouse.")
complete_message = "Sunflowers brighten the lighthouse window."
