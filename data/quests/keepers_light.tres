[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_step")
text = "Meet Luna, the lighthouse keeper"
kind = 4
target = &"luna"
amount = 1
or_event = &""
items = {}
lines = PackedStringArray("You mended the bridge? For me? Nobody's crossed to the isle in months!", "Come up, come up. See that cracked glass at the top of the tower? That's the lens. It shone with five Glowstones, one from every corner of the island.", "The storm shattered it, and the stones scattered. Your grandpa spent years working out where they went... You've found three already?!", "Then the fourth must be in the sea cave under the cliffs. The tide pools only empty in the morning. Go early!")
minutes = 0

[sub_resource type="Resource" id="Step_3"]
script = ExtResource("2_step")
text = "Explore the sea cave at low tide (6–10 AM)"
kind = 0
target = &"shard_4"
amount = 1
or_event = &""
items = {}
lines = PackedStringArray()
minutes = 0

[sub_resource type="Resource" id="Step_4"]
script = ExtResource("2_step")
