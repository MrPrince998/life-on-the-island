[resource]
script = ExtResource("1_quest")
id = &"keepers_light"
title = "Ch. 4: The Keeper's Light"
giver = "Luna"
description = "A rockfall from the cliff smashed the footbridge to Lighthouse Isle, where Luna keeps watch over a dark tower and a cracked lens. She's been cut off ever since."
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5")])
starts_active = false
start_flag = &"shard_3"
next_quest = &""
reward_coins = 150
reward_items = {}
reward_flags = Array[StringName]([])
reward_friendship = 0
giver_id = &""
offer_hearts = 1
requires_quest = &""
requires_flag = &""
offer_lines = PackedStringArray()
complete_message = "All five Glowstone shards! Luna says that with Theo's help the lens could shine again... Chapter 4 complete!"
