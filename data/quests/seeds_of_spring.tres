[resource]
script = ExtResource("1_quest")
id = &"seeds_of_spring"
title = "Ch. 1: Seeds of Spring"
giver = "Mia"
description = "Mia wants the old windmill on the rise turning again, like in Grandpa's day. First, the brambles on the farm path."
steps = Array[ExtResource("2_step")]([SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5")])
starts_active = false
start_flag = &"met_mia"
next_quest = &""
reward_coins = 80
complete_message = "The windmill turns, Grandpa's orchard is planted, and butterflies are drifting over Sunflower Fields. Chapter 1 complete!"
