[gd_resource type="Resource" script_class="CropData" format=3]
[ext_resource type="PackedScene" path="res://scenes/props/crops/tomato_growing.tscn" id="growing"]
[ext_resource type="PackedScene" path="res://scenes/props/crops/tomato_ready.tscn" id="ready"]

[ext_resource type="Script" path="res://scripts/resources/crop_data.gd" id="1_crop"]

[resource]
script = ExtResource("1_crop")
id = &"tomato"
display_name = "Tomatoes"
seed_item_id = &"tomato_seeds"
harvest_item_id = &"tomato"
harvest_amount = 3
grow_hours = 36.0
look = &"tomato"
plants_per_row = 3
plant_scale = 1.25
seasons = Array[StringName]([&"summer"])
stage_models = Array[PackedScene]([null, ExtResource("growing"), ExtResource("growing"), ExtResource("ready")])
