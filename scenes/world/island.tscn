[node name="Page9" type="Area3D" parent="StoryPlaces/Story"]
script = ExtResource("sp_78")
interaction_id = &"journal_page_9"
page = 9
text = "Five stones, one lens, and a keeper to tend it. When the light shines again, row out to my little isle in the lake. I left you something under my tree."

[node name="LedgerPage5" type="Area3D" parent="StoryPlaces/Story"]
script = ExtResource("sp_78")
interaction_id = &"journal_page_5"
