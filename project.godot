; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Life on the Island"
config/description="A cozy life simulation and exploration game."
config/version="0.1.0"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ActivityClock="*res://scripts/systems/activity_clock.gd"
GameManager="*res://scripts/systems/game_manager.gd"
InventoryManager="*res://scripts/systems/inventory_manager.gd"
Journal="*res://scripts/systems/journal.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
WeatherManager="*res://scripts/systems/weather_manager.gd"
Friendship="*res://scripts/systems/friendship.gd"
QuestLog="*res://scripts/systems/quest_log.gd"
RequestBoard="*res://scripts/systems/requests/request_board.gd"
UISounds="*res://scripts/systems/ui_sounds.gd"
StorySounds="*res://scripts/systems/story_sounds.gd"
MusicDirector="*res://scripts/systems/music/music_director.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/cozy_theme.tres"

